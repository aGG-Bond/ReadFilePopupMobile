{
  "name": "@aggbond/my-file-preview-mobile",
  "version": "1.0.9",
  "publishConfig": {
    "provenance": false,
    "access": "public"
  },
  "description": "A secure file preview plugin supporting PDF, text, HTML and rich text files with XSS protection",
  "type": "module",
  "main": "dist/ReadFilePopupMobile.es.js",
  "module": "dist/ReadFilePopupMobile.es.js",
  "types": "dist/types/ReadFilePopupMobile.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/ReadFilePopupMobile.d.ts",
      "import": "./dist/ReadFilePopupMobile.es.js"
    },
    "./min": {
      "import": "./dist/ReadFilePopupMobile.es.min.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run minify",
    "minify": "node scripts/minify.cjs",
    "preview": "vite preview",
    "test": "jest",
    "prepublishOnly": "npm run build && npm run security-check",
    "docs": "typedoc --out docs/api src/",
    "security-check": "echo 'Running security checks...' && npm audit --omit=dev --audit-level moderate",
    "security-audit": "npm audit --omit=dev"
  },
  "keywords": [
    "files-preview",
    "pdf",
    "text",
    "html",
    "popup",
    "mobile",
    "security",
    "xss-protection"
  ],
  "author": "aGG-Bond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aGG-Bond/ReadFilePopupMobile.git"
  },
  "bugs": {
    "url": "https://github.com/aGG-Bond/ReadFilePopupMobile/issues"
  },
  "homepage": "https://github.com/aGG-Bond/ReadFilePopupMobile#readme",
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pdfjs-dist": "^6.2.108",
    "terser": "^5.44.1",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@aggbond/my-popup": "^1.1.0",
    "dompurify": "^3.4.17"
  }
}
